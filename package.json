{
  "name": "cyberloop",
  "version": "1.0.0",
  "description": "Middleware framework for agent control loops with semantic drift detection and geometric control",
  "keywords": [
    "ai-agent",
    "agent",
    "agent-framework",
    "agent-middleware",
    "agent-runtime",
    "agent-control",
    "agent-observability",
    "semantic-drift",
    "drift-detection",
    "geometric-control",
    "control-theory",
    "cybernetic",
    "cybernetics",
    "aicl",
    "llm",
    "llm-agent",
    "autonomous-agent",
    "multi-step-agent",
    "agent-loop",
    "middleware",
    "typescript",
    "openai",
    "embeddings",
    "pid",
    "kalman-filter",
    "manifold",
    "grassmannian",
    "trajectory",
    "evaluation"
  ],
  "homepage": "https://github.com/roackb2/cyberloop#readme",
  "bugs": {
    "url": "https://github.com/roackb2/cyberloop/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roackb2/cyberloop.git"
  },
  "license": "Apache-2.0",
  "author": "Jay / Fienna Liang (roackb2@gmail.com)",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./advanced": {
      "types": "./dist/advanced/index.d.ts",
      "import": "./dist/advanced/index.js",
      "require": "./dist/advanced/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "tsup",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:cov": "vitest --coverage",
    "test:ui": "vitest --ui",
    "examples:quickstart": "tsx src/examples/quickstart.ts",
    "examples:middleware": "tsx src/examples/middleware-demo.ts",
    "examples:openai-agents": "tsx src/examples/openai-agents-demo.ts",
    "examples:github": "tsx src/examples/github/agent-demo.ts",
    "examples:github:cyberloop": "tsx src/examples/github/agent-demo-cyberloop.ts",
    "examples:github:baseline": "tsx src/examples/github/baseline-demo.ts",
    "examples:github:baseline:cyberloop": "tsx src/examples/github/baseline-demo-cyberloop.ts",
    "examples:wikipedia": "tsx src/examples/wikipedia/demo.ts",
    "examples:wikipedia:cyberloop": "tsx src/examples/wikipedia/demo-cyberloop.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/node": "^24.7.1",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "commander": "^14.0.3",
    "eslint": "^9.37.0",
    "eslint-plugin-n": "^17.23.1",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^16.4.0",
    "jiti": "^2.6.1",
    "pino-pretty": "^13.1.2",
    "tsc-alias": "^1.8.16",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@octokit/rest": "^21.0.0",
    "@openai/agents": "^0.1.9",
    "dotenv": "^17.2.3",
    "ml-matrix": "^6.12.1",
    "pino": "^10.1.0",
    "zod": "^4.1.12"
  }
}
